#!/usr/bin/bash

cleanup() {
  printf "\nInterrupted. Exiting...\n"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill -CONT "$pid"
    sleep 0.2
    kill "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
  fi
  exit 0
}
trap cleanup SIGINT

loop_enabled=0
pf_enabled=0
file=""
folder=""
key=""
is_paused=0

print_error() {
  printf "Error: %s\n" "$1"
  printf "See --help for more info\n"
}

print_help() {
  printf "SONIC - Terminal Music Player\n\n"

  printf "Usage:\n"
  printf "\tsonic <file>\n"
  printf "\tsonic -pf <folder>\n"
  printf "\tsonic <file> [-lp]\n"
  printf "\tsonic -pf <folder> [-lp]\n"

  printf "\n"

  printf "Options:\n"
  printf "\t%-24s %s\n" "-h, --help" "Show help"
  printf "\t%-24s %s\n" "-lp, --loop" "Loop song or playlist"
  printf "\t%-24s %s\n" "-pf, --play-folder" "Play songs from the specified folder"

  printf "\n"

  printf "Controls:\n"
  printf "\t%-1s %s\n" "p" "Pause/Play music"
  printf "\t%-1s %s\n" "n" "Next song"
  printf "\t%-1s %s\n" "b" "Previous song"
  printf "\t%-1s %s\n" "q" "Quit"
}

init_audio_engine() {
  local song="$1"
  printf "\rNow playing: %-60s" "${song##*/}"

  ffplay -nodisp -autoexit -nostats -hide_banner "$song" &
  pid=$!
}

pause_n_play() {
  if [[ $is_paused -eq 0 ]]; then
    kill -STOP "$pid"
    printf "\r[Paused] Now playing: %-60s" "${song##*/}"
    is_paused=1
  else
    kill -CONT "$pid"
    printf "\rNow playing: %-60s" "${song##*/}"
    is_paused=0
  fi
}

play_next() {
  if ((loop_enabled)); then
    i=$(((i + 1) % len_playlist))
  else
    ((i++))
  fi
}

play_before() {
  if ((loop_enabled)); then
    i=$(((i - 1 + len_playlist) % len_playlist))
  else
    ((i--))
  fi
}

add_key_listener() {
  while kill -0 "$pid" 2>/dev/null; do

    key=""
    read -rsn1 -t 0.1 key

    if [[ $key == "p" ]]; then
      pause_n_play

    elif [[ $key == "n" ]]; then
      play_next
      break

    elif [[ $key == "b" ]]; then
      play_before
      break

    elif [[ $key == "q" ]]; then
      cleanup
    fi

  done
}

# ===== arg parsing ===== #
while [[ $# -gt 0 ]]; do

  case "$1" in

  "-h" | "--help")
    print_help
    exit 0
    ;;

  "-lp" | "--loop")
    loop_enabled=1
    shift
    ;;

  "-pf" | "--play-folder")
    if [[ -z "$2" ]]; then
      print_error "'$1' requires a folder"
      exit 1
    fi

    pf_enabled=1
    folder="${2%/}"
    shift 2
    ;;

  -*)
    print_error "unknown option '$1'"
    exit 1
    ;;

  *)
    if [[ -n "$file" ]]; then
      print_error "cannot play multiple files"
      exit 1
    fi

    file="$1"
    shift
    ;;

  esac

done

# ===== dependency check ===== #
if ! command -v ffplay >/dev/null 2>&1; then
  printf "Error: ffplay is not installed\n"
  printf "Please install ffmpeg to use this music player\n"
  exit 1
fi

# ===== arg validation ===== #
if [[ -z "$file" && -z "$folder" ]]; then
  print_error "no file or folder has been provided"
  exit 1
fi

if [[ -n "$file" && -n "$folder" ]]; then
  print_error "cannot play file and folder together"
  exit 1
fi

if [[ -n "$file" && ! -f "$file" ]]; then
  print_error "invalid file"
  exit 1
fi

if [[ -n "$folder" && ! -d "$folder" ]]; then
  print_error "invalid folder"
  exit 1
fi

# ===== build playlist ===== #
playlist=()

if ((pf_enabled)); then
  for f in "$folder"/*; do
    if [[ -f "$f" && "${f,,}" == *.mp3 ]]; then
      playlist+=("$f")
    fi
  done

  if [[ ${#playlist[@]} -eq 0 ]]; then
    printf "Only mp3 files are supported\n"
    printf "'$folder' has no mp3 files\n"
    exit 1
  fi

else
  if [[ "${file,,}" != *.mp3 ]]; then
    printf "Error: only mp3 files are supported\n"
    exit 1
  fi

  playlist+=("$file")
fi

# ===== playback logic ===== #
len_playlist=${#playlist[@]}

if ((loop_enabled)); then
  printf "Looping enabled\n"

  i=0
  while true; do
    song="${playlist[i]}"
    is_paused=0

    init_audio_engine "$song"

    add_key_listener

    if kill -0 "$pid" 2>/dev/null; then
      kill -CONT "$pid"
      sleep 0.2
      kill "$pid" 2>/dev/null
    fi
    wait "$pid" 2>/dev/null

    if [[ $key == "" || ($key != "n" && $key != "b") ]]; then
      i=$(((i + 1) % len_playlist))
    fi
  done

else
  for ((i = 0; i >= 0 && i < len_playlist; )); do

    song="${playlist[i]}"
    is_paused=0

    init_audio_engine "$song"

    add_key_listener

    if kill -0 "$pid" 2>/dev/null; then
      kill -CONT "$pid"
      sleep 0.2
      kill "$pid" 2>/dev/null
    fi
    wait "$pid" 2>/dev/null

    if [[ $key == "" || ($key != "n" && $key != "b") ]]; then
      ((i++))
    fi

  done
fi
