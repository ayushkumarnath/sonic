#!/usr/bin/bash

readonly VERSION="1.1.0"

# Global constants
readonly TRUE=1
readonly FALSE=0
readonly ESC=$'\033'
readonly RESET='\033[0m'

# Colors
readonly RED='\033[0;31m'

# Configuration states
readonly MAX_SONG_TITLE_LEN=50
loop_enabled=0
play_folder_enabled=0
is_paused=$FALSE

# Media playback
readonly SKIP_LENGTH_MS=10000
file=""
folder=""
song=""

# Playback state
playback_start_time_ms=0
total_playback_duration_ms=0

# UI icons
play_icon='\u25B6'
pause_icon='\u007C\u007C'
progress_filled_block_icon='\u2588'
progress_empty_block_icon='\u2591'

# Playback control keys
readonly PAUSE_KEY="k"
readonly NEXT_SONG_KEY="n"
readonly PREVIOUS_SONG_KEY="p"
readonly SKIP_FORWARD_KEY="l"
readonly SKIP_BACKWARD_KEY="j"
readonly QUIT_KEY="q"
key=""

# ===== UTILITY FUNCTIONS ===== #
print_error() {
    printf "Error: %s\n" "$1"
    printf "See --help for more info\n"
}

print_help() {
    printf "SONIC - Terminal Music Player\n\n"

    printf "Usage:\n"
    printf "\tsonic <file>\n"
    printf "\tsonic -f <folder>\n"
    printf "\tsonic <file> [-l]\n"
    printf "\tsonic -f <folder> [-l]\n"

    printf "\n"

    printf "Options:\n"
    printf "\t%-24s %s\n" "-h, --help" "Show help"
    printf "\t%-24s %s\n" "-l, --loop" "Loop song or playlist"
    printf "\t%-24s %s\n" "-f, --play-folder" "Play songs from the specified folder"
    printf "\t%-24s %s\n" "-v, --version" "Show version info"

    printf "\n"

    printf "Controls:\n"
    printf "\t%-1s %s\n" "$PAUSE_KEY" "Pause/Play music"
    printf "\t%-1s %s\n" "$NEXT_SONG_KEY" "Next song"
    printf "\t%-1s %s\n" "$PREVIOUS_SONG_KEY" "Previous song"
    printf "\t%-1s %s\n" "$SKIP_BACKWARD_KEY" "Seek backward $(( SKIP_LENGTH_MS / 1000 )) seconds"
    printf "\t%-1s %s\n" "$SKIP_FORWARD_KEY" "Seek forward $(( SKIP_LENGTH_MS / 1000 )) seconds"
    printf "\t%-1s %s\n" "$QUIT_KEY" "Quit"
}

print_version_info() {
    printf "SONIC v${VERSION}\n"
}

# ===== TIME UTILITIES ===== #
current_time_ms() {
    printf '%s\n' "$(( ${EPOCHREALTIME//.} / 1000 ))"
}

format_ms_to_seconds() {
    printf '%d.%03d' \
        $(( $1 / 1000 )) \
        $(( $1 % 1000 ))
}

# ===== TIMING STATE ===== #
timing_start_segment() {
    playback_start_time_ms=$(current_time_ms)
}

timing_get_position() {
    printf '%s\n' "$(( total_playback_duration_ms + ($(current_time_ms) - playback_start_time_ms) ))"
}

timing_commit_position() {
    local position=$(timing_get_position)
    total_playback_duration_ms=$position
}

timing_seek_forward() {
    # param: seek_len
    local seek_len=$1

    (( total_playback_duration_ms += seek_len ))
}

timing_seek_backward() {
    # param: seek_len
    local seek_len=$1

    if (( total_playback_duration_ms <= seek_len )); then
        total_playback_duration_ms=0
    else
        (( total_playback_duration_ms -= seek_len ))
    fi
}

timing_reset() {
    playback_start_time_ms=0
    total_playback_duration_ms=0
}

# ===== UI ===== #
print_song_title() {
    # params: song
    local song="$1"

    local song_title="${song##*/}"
    local len_song_title=${#song_title}

    printf "\r${ESC}[KNow playing: %s" "${song_title:0:MAX_SONG_TITLE_LEN}"
    if ((len_song_title > MAX_SONG_TITLE_LEN)); then
        printf "..."
    fi

    # Save cursor position
    printf "${ESC}[s"
}

# ===== LOW LEVEL ===== #
start_ffplay() {
    # params: song, pos?
    local song="$1"
    local pos="$2"

    if [[ -n $pos ]]; then
        ffplay -nodisp -autoexit -nostats -hide_banner -ss "$pos" "$song" &
    else
        ffplay -nodisp -autoexit -nostats -hide_banner "$song" &
    fi

    ffplay_pid=$!
}

ffplay_exists() {
    [[ -n "$1" ]] && kill -0 "$1" 2>/dev/null
}

stop_ffplay() {
    if ffplay_exists "$ffplay_pid"; then
        kill -CONT "$ffplay_pid"
        sleep 0.2
        kill "$ffplay_pid" 2>/dev/null
        wait "$ffplay_pid" 2>/dev/null
        ffplay_pid=""
    fi
}

# ===== MEDIA METADATA ===== #
probe_media_duration() {
    # params: song
    local song="$1"

    local media_duration_seconds="$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$song")"

    if [[ -z "$media_duration_seconds" || ! "$media_duration_seconds" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        printf '%s\n' 0
        return 1
    fi

    local media_duration_ms=$(awk -v sec="$media_duration_seconds" 'BEGIN { printf "%d\n", sec * 1000 }')

    printf '%s\n' "$media_duration_ms"
}

# ===== MEDIA PLAYER ===== #
finish_current_playback() {
    if ffplay_exists "$ffplay_pid"; then
        kill -CONT "$ffplay_pid"
        sleep 0.2
        kill "$ffplay_pid" 2>/dev/null
    fi
    wait "$ffplay_pid" 2>/dev/null
    ffplay_pid=""
}

start_playback() {
    # params: song, pos?
    local song="$1"
    local pos="$2"

    if [[ -n $pos ]]; then
        start_ffplay "$song" "$pos"
    else
        start_ffplay "$song"
    fi
    print_song_title "$song"
}

stop_playback() {
    stop_ffplay
}

pause_playback() {
    kill -STOP "$ffplay_pid"
    printf "${ESC}[u (Paused)"
    is_paused=$TRUE
}

resume_playback() {
    stop_playback
    start_playback \
        "$song" \
        "$(format_ms_to_seconds "$total_playback_duration_ms")"
    printf "${ESC}[u${ESC}[K"
    is_paused=$FALSE
}

toggle_pause() {
    if ! (($is_paused)); then
        pause_playback
        timing_commit_position
    else
        resume_playback
        timing_start_segment
    fi
}

select_next_song() {
    local len_playlist=${#playlist[@]}

    if ((loop_enabled)); then
        i=$(((i + 1) % len_playlist))
    else
        ((i++))
    fi
}

select_previous_song() {
    local len_playlist=${#playlist[@]}

    if ((loop_enabled)); then
        i=$(((i - 1 + len_playlist) % len_playlist))
    else
        ((i--))
    fi
}

skip_forward() {
    if ((is_paused)); then
        timing_seek_forward "$SKIP_LENGTH_MS"
    else
        timing_commit_position
        timing_seek_forward "$SKIP_LENGTH_MS"
        stop_playback
        start_playback \
            "$song" \
            "$(format_ms_to_seconds "$total_playback_duration_ms")"
        timing_start_segment
    fi
}

skip_backward() {
    if ((is_paused)); then
        timing_seek_backward "$SKIP_LENGTH_MS"
    else
        timing_commit_position
        stop_playback
        timing_seek_backward "$SKIP_LENGTH_MS"
        start_playback \
            "$song" \
            "$(format_ms_to_seconds "$total_playback_duration_ms")"
        timing_start_segment
    fi
}

# ===== EXIT HANDLING ===== #
cleanup() {
    stop_playback
    printf "\nInterrupted. Exiting...\n"
    exit 0
}
trap cleanup SIGINT

# ===== EVENT HANDLING ===== #
handle_playback_input() {
    while ffplay_exists "$ffplay_pid"; do
        key=""
        read -rsn1 -t 0.1 key

        if [[ -n "$key" ]]; then
            case "$key" in
                $PAUSE_KEY)
                    toggle_pause
                    ;;
                $SKIP_FORWARD_KEY)
                    skip_forward
                    ;;
                $SKIP_BACKWARD_KEY)
                    skip_backward
                    ;;
                $NEXT_SONG_KEY | $PREVIOUS_SONG_KEY | $QUIT_KEY)
                    break
                    ;;
            esac
        fi
    done
}

process_playback_key() {
    case "$key" in
        $NEXT_SONG_KEY)
            select_next_song
            ;;
        $PREVIOUS_SONG_KEY)
            select_previous_song
            ;;
        $QUIT_KEY)
            cleanup
            ;;
    esac
}

# ===== PLAYBACK LOGIC ===== #
run_playback_loop() {
    local len_playlist=${#playlist[@]}

    i=0
    while true; do
        song="${playlist[i]}"
        is_paused=$FALSE
        timing_reset

        start_playback "$song"
        timing_start_segment

        handle_playback_input

        process_playback_key

        finish_current_playback

        if [[ $key == "" || ($key != $NEXT_SONG_KEY && $key != $PREVIOUS_SONG_KEY) ]]; then
            select_next_song
        fi

        if [[ $i -lt 0 || $i -ge $len_playlist ]] && ! ((loop_enabled)); then
            break
        fi
    done
}

run_player() {
    if ((loop_enabled)); then
        printf "Looping enabled\n"
    fi

    run_playback_loop
}

# ===== ARGUMENT PARSING ===== #
parse_arguments() {
    if [[ $# -eq 0 ]]; then
        print_help
        exit 0
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            "-h" | "--help")
                print_help
                exit 0
                ;;

            "-v" | "--version")
                print_version_info
                exit 0
                ;;

            "-l" | "--loop")
                loop_enabled=$TRUE
                shift
                ;;

            "-f" | "--play-folder")
                if [[ -z "$2" ]]; then
                    print_error "'$1' requires a folder"
                    exit 1
                fi

                play_folder_enabled=$TRUE
                folder="${2%/}"
                shift 2
                ;;

            -*)
                print_error "unknown option '$1'"
                exit 1
                ;;

            *)
                if [[ -n "$file" ]]; then
                    print_error "cannot play multiple files"
                    exit 1
                fi

                file="$1"
                shift
                ;;
        esac
    done
}

# ===== DEPENDENCY CHECK ===== #
require() {
    if ! command -v "$1" >/dev/null 2>&1; then
        missing_deps+=("$1")
    fi
}

check_dependencies() {
    missing_deps=()

    local deps=("ffplay" "ffprobe" "gawk")
    local dep

    for dep in "${deps[@]}"; do
        require "$dep"
    done

    if [[ ${#missing_deps[@]} -ne 0 ]]; then
        for dep in "${missing_deps[@]}"; do
            printf "${RED}Error:${RESET} dependency '%s' not found\n" "$dep" >&2
        done
        printf "Please install the required dependencies\n\n" >&2
        exit 1
    fi
}

# ===== ARGUMENT VALIDATION ===== #
validate_arguments() {
    if [[ -n "$file" && -n "$folder" ]]; then
        print_error "cannot play file and folder together"
        exit 1
    fi

    if [[ -n "$file" && ! -f "$file" ]]; then
        print_error "invalid file"
        exit 1
    fi

    if [[ -n "$folder" && ! -d "$folder" ]]; then
        print_error "invalid folder"
        exit 1
    fi
}

# ===== BUILD PLAYLIST ===== #
build_playlist() {
    playlist=()

    local f

    if ((play_folder_enabled)); then
        for f in "$folder"/*; do
            if [[ -f "$f" && "${f,,}" == *.mp3 ]]; then
                playlist+=("$f")
            fi
        done

        if [[ ${#playlist[@]} -eq 0 ]]; then
            printf "Only mp3 files are supported\n"
            printf "'$folder' has no mp3 files\n"
            exit 1
        fi
    else
        if [[ "${file,,}" != *.mp3 ]]; then
            printf "Error: only mp3 files are supported\n"
            exit 1
        fi

        playlist+=("$file")
    fi
}

# ===== MAIN ===== #
main() {
    parse_arguments "$@"
    check_dependencies
    validate_arguments
    build_playlist
    run_player

    printf "\n"

    return 0
}

# ===== PROGRAM STARTS ===== #
main "$@"
